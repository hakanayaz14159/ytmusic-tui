* {
    box-sizing: border-box;
}

App {
    background: $background;
    color: $foreground;
}

AppShell {
    width: 100%;
    height: 100%;
    layout: vertical;
}

ModeBar {
    dock: top;
    width: 100%;
    height: 1;
    background: $panel;
    color: $foreground;
    padding: 0 1;
    align: left middle;
}

ModeBar .mode-tab {
    width: auto;
    color: $text-muted;
    padding: 0 1;
}

ModeBar .mode-tab.-active {
    color: $primary;
    text-style: bold;
}

ModeBar #mode_user {
    width: 1fr;
    content-align: right middle;
    color: $text-muted;
}

#body_row {
    width: 100%;
    height: 1fr;
}

#main_column {
    width: 1fr;
    height: 100%;
}

#queue_pane {
    width: 36;
    height: 100%;
    display: none;
    border-left: solid $border;
    background: $surface;
}

#queue_pane.-visible {
    display: block;
}

#chrome {
    dock: bottom;
    width: 100%;
    height: 3;
}

#chrome.-compact {
    height: 2;
}

NowPlaying {
    width: 100%;
    height: 2;
    background: $panel;
    color: $foreground;
    padding: 0 1;
}

NowPlaying.-compact {
    height: 1;
}

NowPlaying #np_title {
    width: 100%;
    color: $success;
}

NowPlaying #np_detail {
    width: 100%;
    color: $text-muted;
}

NowPlaying.-compact #np_detail {
    display: none;
}

StatusBar {
    width: 100%;
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

SearchMode,
QueueMode,
ProfilesMode,
SettingsMode {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    overflow: hidden hidden;
    background: $background;
}

PlaylistsMode {
    width: 1fr;
    height: 1fr;
    layout: horizontal;
    overflow: hidden hidden;
    background: $background;
}

SearchMode #search_input {
    margin: 1 1 0 1;
    border: solid $border;
}

SearchMode #search_input:focus {
    border: tall $accent;
}

SearchMode #suggestion_list {
    height: auto;
    max-height: 8;
    margin: 0 1;
    background: $panel;
    border: solid $border;
}

SearchMode #suggestion_list > .option-list--option-highlighted {
    background: $primary;
    color: $background;
}

SearchMode #search_status,
QueueMode #queue_working {
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

SongTable {
    width: 100%;
    height: 1fr;
    background: $surface;
}

SongTable #song_table_header {
    color: $text-muted;
    padding: 0 1;
    height: 1;
}

SongTable ListView {
    height: 1fr;
    border: none;
    background: $surface;
}

SongTable ListView:focus {
    border: tall $accent;
}

SongTable ListView > ListItem.-playing {
    color: $success;
}

SongTable ListView > ListItem.--highlight {
    background: $primary;
    color: $background;
}

QueueMode #queue_empty,
PlaylistsMode #playlists_empty,
ProfilesMode #profiles_empty {
    height: 1fr;
    color: $text-muted;
    content-align: center middle;
    padding: 1;
}

PlaylistsMode {
    layout: horizontal;
}

PlaylistsMode #playlist_list {
    width: 28;
    height: 100%;
    border-right: solid $border;
    background: $surface;
}

PlaylistsMode #playlist_list:focus {
    border: tall $accent;
}

PlaylistsMode #playlist_tracks {
    width: 1fr;
    height: 100%;
}

ProfilesMode OptionList,
SettingsMode OptionList {
    width: 100%;
    height: 1fr;
    background: $surface;
    border: none;
}

ProfilesMode OptionList:focus,
SettingsMode OptionList:focus {
    border: tall $accent;
}

HelpModal {
    align: center middle;
}

HelpModal #help_panel {
    width: 72;
    height: auto;
    max-height: 22;
    background: $panel;
    border: solid $primary;
    padding: 1 2;
}

HelpModal #help_panel:focus {
    border: solid $accent;
}

PromptModal,
ConfirmModal,
AddToPlaylistModal {
    align: center middle;
}

PromptModal #prompt_panel,
ConfirmModal #confirm_panel,
AddToPlaylistModal #picker_panel {
    width: 56;
    height: auto;
    background: $panel;
    border: solid $primary;
    padding: 1 2;
}

PromptModal Input {
    border: solid $border;
    margin-top: 1;
}

PromptModal Input:focus {
    border: tall $accent;
}

AddToPlaylistModal OptionList:focus {
    border: tall $accent;
}
